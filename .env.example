# Copy this file to ".env" at the repo root and fill in the API key for your
# chosen provider. One .env serves everything: the eval harness, the session
# script, and later the backend.
#
# Which key is read is controlled by `api_key_env`: in the eval that comes from
# assessment-agent-eval/config.yaml, elsewhere from a flag or a setting.

# Google AI Studio — free tier (default provider). Get a key:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI-compatible providers — only fill in the one you actually use:
# GROQ_API_KEY=         # https://console.groq.com/keys
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys
# OPENAI_API_KEY=

# --- Auth (backend) ---------------------------------------------------------
# Google OAuth client, from the Google Cloud console (APIs & Services →
# Credentials → OAuth client ID, "Web application"). Register the redirect URI
# <app_base_url>/auth/callback, e.g. http://localhost:5173/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string locally; a real secret in
# deployed environments. Generate one: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
# Emails that sign in as instructors (comma-separated). Everyone else is a
# student. Leave empty to sign in as a student.
INSTRUCTOR_EMAILS=
# Optional. Defaults suit local dev:
# APP_BASE_URL=http://localhost:5173   # the origin used to build the redirect URI
# AUTH_DEV_BYPASS=true                 # act-as sign-in; forced off in production
# ENVIRONMENT=local                    # local | development | production
