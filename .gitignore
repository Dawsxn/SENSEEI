# Secrets — never commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Design canvases are assembled from design/*.dc.html by the seeding helper.
# The output embeds the whole editor (~2MB), so keep the sources and not the build.
design/**/*.html
!design/**/*.dc.html

# Terminal session transcripts from scripts/session.py
scripts/runs/

# OS
.DS_Store
Thumbs.db
desktop.ini
