# Copy this file to ".env" and fill in the API key for your chosen provider.
# Which key is read is controlled by `api_key_env` in config.yaml.

# Google AI Studio — free tier (default provider). Get a key:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI-compatible providers — only fill in the one you actually use:
# GROQ_API_KEY=         # https://console.groq.com/keys
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys
# OPENAI_API_KEY=
